

# Django core
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_TYPE=sqlite

#  PostgreSQL / PostGIS credentials 

POSTGRES_DB=urban_crime_intel
POSTGRES_USER=urban_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── GDAL (required for PostGIS on Windows) ─────────────────
# Uncomment and set the path to your local GDAL DLL if Django
# raises "Could not find the GDAL library" on Windows.
# Example: C:\OSGeo4W\bin\gdal309.dll
# GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal309.dll

# ── CORS (Frontend dev server origins) ────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
